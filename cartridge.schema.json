{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trench/cartridge.schema.json",
  "title": "TRENCH packed cartridge",
  "description": "Runtime wrapper for one exact 240-byte packed body. Source-session and proof metadata are separate artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "sampleRate", "keyframes"],
  "properties": {
    "format": { "const": "compiled-v1" },
    "name": { "type": "string", "minLength": 1 },
    "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
    "keyframes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/m0_q0" },
        { "$ref": "#/$defs/m100_q0" },
        { "$ref": "#/$defs/m0_q100" },
        { "$ref": "#/$defs/m100_q100" }
      ],
      "items": false
    },
    "drive": { "$ref": "#/$defs/drive" },
    "spatial_profile": { "$ref": "#/$defs/spatial_profile" }
  },
  "$defs": {
    "packed_words": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "boost", "packedWords"],
      "properties": {
        "label": { "type": "string" },
        "boost": { "type": "number" },
        "packedWords": { "$ref": "#/$defs/packed_words" }
      }
    },
    "m0_q0": {
      "allOf": [
        { "$ref": "#/$defs/keyframe" },
        { "properties": { "label": { "const": "M0_Q0" } } }
      ]
    },
    "m100_q0": {
      "allOf": [
        { "$ref": "#/$defs/keyframe" },
        { "properties": { "label": { "const": "M100_Q0" } } }
      ]
    },
    "m0_q100": {
      "allOf": [
        { "$ref": "#/$defs/keyframe" },
        { "properties": { "label": { "const": "M0_Q100" } } }
      ]
    },
    "m100_q100": {
      "allOf": [
        { "$ref": "#/$defs/keyframe" },
        { "properties": { "label": { "const": "M100_Q100" } } }
      ]
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_gain_dB", "model"],
      "properties": {
        "input_gain_dB": { "type": "number" },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "spatial_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azimuth", "distance", "elevation", "itd_coeffs", "ild_coeffs", "band_coeffs"],
      "properties": {
        "azimuth": { "type": "number" },
        "distance": { "type": "number" },
        "elevation": { "type": "number" },
        "itd_coeffs": { "$ref": "#/$defs/law6" },
        "ild_coeffs": { "$ref": "#/$defs/law6" },
        "band_coeffs": { "$ref": "#/$defs/band_coeffs" }
      }
    },
    "law6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "number" }
    },
    "band12": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "number" }
    },
    "band_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "mid", "high"],
      "properties": {
        "low": { "$ref": "#/$defs/band12" },
        "mid": { "$ref": "#/$defs/band12" },
        "high": { "$ref": "#/$defs/band12" }
      }
    },
    "band_coeffs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l", "r"],
      "properties": {
        "l": { "$ref": "#/$defs/band_channel" },
        "r": { "$ref": "#/$defs/band_channel" }
      }
    }
  }
}
