{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trench/specs/response_target.v1.schema.json",
  "title": "TRENCH response target v1",
  "description": "Creative authoring schema: describe the desired full magnitude response surface first. A packing solver may later realize it as 4 corners x 6 stages x 5 packed words.",
  "type": "object",
  "required": ["format", "name", "grid", "anchors", "motion", "q"],
  "additionalProperties": false,
  "properties": {
    "format": { "type": "string", "const": "response-target-v1" },
    "name": { "type": "string", "minLength": 1 },
    "intent": { "type": "string" },
    "grid": {
      "type": "object",
      "required": ["scale", "lo_hz", "hi_hz", "points"],
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "string", "const": "log-frequency" },
        "lo_hz": { "type": "number", "exclusiveMinimum": 0 },
        "hi_hz": { "type": "number", "exclusiveMinimum": 0 },
        "points": { "type": "integer", "minimum": 16 }
      }
    },
    "bands": {
      "type": "array",
      "items": { "$ref": "#/$defs/band" },
      "default": [
        { "name": "low", "lo_hz": 20, "hi_hz": 200 },
        { "name": "body", "lo_hz": 200, "hi_hz": 1200 },
        { "name": "bite", "lo_hz": 1200, "hi_hz": 5500 },
        { "name": "air", "lo_hz": 5500, "hi_hz": 16000 }
      ]
    },
    "anchors": {
      "type": "object",
      "description": "Magnitude targets for the low-Q Morph endpoints. Curves are the musical truth; stages are not named here.",
      "required": ["M0_Q0", "M100_Q0"],
      "additionalProperties": false,
      "properties": {
        "M0_Q0": { "$ref": "#/$defs/curve_target" },
        "M100_Q0": { "$ref": "#/$defs/curve_target" }
      }
    },
    "motion": {
      "type": "object",
      "description": "What Morph does to the response, measured as curve movement.",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "centroid_delta_hz": { "$ref": "#/$defs/range" },
        "rms_delta_db": { "$ref": "#/$defs/range" },
        "band_deltas_db": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/range" }
        }
      }
    },
    "q": {
      "type": "object",
      "description": "What Q does to the response, measured as curve change rather than stage-radius recipe.",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "sharpen_db": { "$ref": "#/$defs/range" },
        "fracture_db": { "$ref": "#/$defs/range" },
        "centroid_delta_hz": { "$ref": "#/$defs/range" },
        "peak_budget_db": { "$ref": "#/$defs/range" }
      }
    },
    "packing": {
      "type": "object",
      "description": "Solver constraints for the final bookkeeping rows.",
      "additionalProperties": false,
      "properties": {
        "stage_count": { "type": "integer", "const": 6 },
        "corner_order": {
          "type": "array",
          "items": { "type": "string", "enum": ["M0_Q0", "M100_Q0", "M0_Q100", "M100_Q100"] },
          "minItems": 4,
          "maxItems": 4
        },
        "max_pack_rms_db": { "type": "number", "minimum": 0 },
        "max_pack_peak_db": { "type": "number", "minimum": 0 },
        "stable_over_surface": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "band": {
      "type": "object",
      "required": ["name", "lo_hz", "hi_hz"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "lo_hz": { "type": "number", "exclusiveMinimum": 0 },
        "hi_hz": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "curve_target": {
      "type": "object",
      "required": ["curve_db"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "curve_db": {
          "type": "array",
          "description": "dB magnitude values aligned to grid.points on the top-level log-frequency grid.",
          "items": { "type": "number" },
          "minItems": 16
        },
        "peaks": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        },
        "notches": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        },
        "centroid_hz": { "$ref": "#/$defs/range" },
        "peak_budget_db": { "$ref": "#/$defs/range" }
      }
    },
    "feature": {
      "type": "object",
      "required": ["freq_hz", "db"],
      "additionalProperties": false,
      "properties": {
        "freq_hz": { "type": "number", "exclusiveMinimum": 0 },
        "db": { "type": "number" },
        "width_oct": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "target": { "type": "number" }
      }
    }
  }
}
