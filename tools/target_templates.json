      "q_axis_rule": {"type": "sharpen", "bw_scale": [0.48, 0.74], "gain_boost_db": [2.5, 7.0]},
      "level_guidance_db": -3,
      "failure_modes": ["vowel identity disappears", "low band turns muddy", "Q becomes a whistle instead of clearer speech"],
      "gates": {"low_rolloff_min_db": 4, "peak_max_db": 7, "morph_motion_min_hz": 110, "morph_chaos_max": 0.8, "q_center_shift_max_hz": 700, "packed_residual_max_db": 16}
    },
