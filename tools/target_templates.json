{
  "_schema": {
    "note": "Producer-facing musical target archetypes for Target Browser. These describe whole 4-corner Morph/Q bodies, not coefficients or stages.",
    "feature": "{kind: peak|notch, freq_hz:[lo,hi], gain_db:[lo,hi], bw_oct:[lo,hi]} sampled per candidate inside the ranges.",
    "morph_axis_rule.type": "shift = move peak centers together; glide = each feature gets its own related move; anchored = body below anchor holds while upper structure moves; translate_comb = notches move together.",
    "q_axis_rule.type": "sharpen = narrower peaks and more lift; deepen = stronger notches; contrast = peaks up and notches down.",
    "gates": "Hard culls only broken bodies: unstable, non-finite, pedestal, clipping, or no Morph motion. Drift/chaos/off-target values are advisory.",
    "axes": "Morph moves identity, geometry, or fracture placement. Q moves sharpness, contrast, or depth."
  },
  "templates": [
    {
      "name": "bright_vowel",
      "label": "bright vowel",
      "listening_goal": "Forward vowel body with a readable talking edge. Morph changes vowel identity; Q tightens the formants.",
      "family": "vocal",
      "floor_db": -23,
      "features": [
        {"kind": "peak", "freq_hz": [260, 520], "gain_db": [12, 19], "bw_oct": [0.28, 0.55]},
        {"kind": "peak", "freq_hz": [1450, 2600], "gain_db": [13, 21], "bw_oct": [0.25, 0.52]},
        {"kind": "peak", "freq_hz": [2800, 4700], "gain_db": [7, 14], "bw_oct": [0.32, 0.65]}
