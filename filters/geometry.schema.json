{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trench/geometry.schema.json",
  "title": "TRENCH body geometry IR",
  "description": "The universal intermediate representation: 4 corners x 6 stages of stage-law authoring variables. Corner order: M0_Q0, M100_Q0, M0_Q100, M100_Q100. Stage slot i pairs across corners (the morph choreography). Compiled to .body240 exclusively by trench-core's body-from-geometry.",
  "type": "object",
  "required": ["name", "corners"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "corners": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "object",
          "required": ["pole_hz", "pole_r", "zero_hz", "zero_r", "scale"],
          "additionalProperties": false,
          "properties": {
            "pole_hz": { "type": "number", "minimum": 0, "maximum": 19531.25 },
            "pole_r":  { "type": "number", "minimum": 0, "maximum": 0.9999 },
            "zero_hz": { "type": "number", "minimum": 0, "maximum": 19531.25 },
            "zero_r":  { "type": "number", "minimum": 0, "maximum": 1.0 },
            "scale":   { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
