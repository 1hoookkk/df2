{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trenchwork.dev/schemas/forge-cartridge-v1.schema.json",
  "title": "Forge Cartridge v1",
  "description": "One file: editable recipe (source) + baked keyframes (authority). The recipe is the design surface; keyframes are the DLL-verified packed bytes the player reads.",
  "type": "object",
  "required": ["format", "name", "recipe"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "forge-cartridge-v1" },
    "name": { "type": "string" },
    "sampleRate": { "type": "number", "default": 39062.5 },
    "meta": { "type": "object", "description": "free: author, tags, provenance notes" },

    "recipe": {
      "type": "object",
      "required": ["axes", "lanes", "constraints"],
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "object",
          "required": ["morph", "secondary"],
          "additionalProperties": false,
          "properties": {
            "morph": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slide_semitones"],
              "properties": {
                "low": { "type": "string", "default": "HOME" },
                "high": { "type": "string", "default": "AWAY" },
                "slide_semitones": { "type": "number" },
                "scale": { "enum": ["log", "linear"], "default": "log" }
              }
            },
            "secondary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "amount"],
              "properties": {
                "low": { "type": "string", "default": "OPEN" },
                "high": { "type": "string", "default": "TIGHT" },
                "mode": { "enum": ["q_crank", "weight", "open"] },
                "amount": { "type": "number" }
              }
            }
          }
        },

        "lanes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "anatomy", "articulation", "survival"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 5 },
              "role": { "type": "string", "description": "free label, e.g. foundation/window/mouth/counterweight/slope/edge_cap/scar/anchor/mover/crosser/cap/canyon" },
              "label": { "type": "string" },
              "anatomy": {
                "type": "object",
                "required": ["pole_hz", "sharp"],
                "additionalProperties": false,
                "properties": {
                  "pole_hz": { "type": "number", "minimum": 20, "maximum": 19140, "description": "HOME pole center" },
                  "sharp": { "type": "number", "minimum": 0.5, "maximum": 0.999 },
                  "away_hz": { "type": "number", "minimum": 20, "maximum": 19140, "description": "optional AWAY-corner pole (the named morph target); overrides global slide for this lane" }
                }
              },
              "articulation": {
                "type": "object",
                "required": ["cut"],
                "additionalProperties": false,
                "properties": {
                  "cut": { "enum": ["none", "hug", "tear", "sub_kill", "air_cap", "air_kill", "custom"] },
                  "zero": {
                    "type": "object",
                    "description": "required when cut == custom; zero defined relative to the pole",
                    "additionalProperties": false,
                    "required": ["ratio", "depth"],
                    "properties": {
                      "ratio": { "type": "number", "description": "follow: zero_hz = pole_hz*ratio; absolute: zero_hz = ratio Hz" },
                      "depth": { "type": "number", "minimum": 0, "maximum": 0.999 },
                      "track": { "enum": ["follow", "absolute"], "default": "follow" }
                    }
                  },
                  "morph_move": { "type": "number", "default": 0, "description": "added to zero ratio across Morph HOME->AWAY ('where the cut moves')" }
                }
              },
              "survival": {
                "type": "object",
                "required": ["gain"],
                "additionalProperties": false,
                "properties": {
                  "gain": { "type": "number", "minimum": 0.3, "maximum": 2.5 }
                }
              }
            }
          }
        },

        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_radius": { "type": "number", "default": 0.999, "maximum": 0.999 },
            "unity_dc": { "type": "boolean", "default": true },
            "on_unstable": { "enum": ["reject", "clamp"], "default": "reject" },
            "headroom_db": { "type": "number", "default": 18.0 }
          }
        },

        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["corner", "lane", "set"],
            "additionalProperties": false,
            "properties": {
              "corner": { "enum": ["home", "away", "tight_home", "tight_away"] },
              "lane": { "type": "integer", "minimum": 0, "maximum": 5 },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pole_hz": { "type": "number" },
                  "sharp": { "type": "number" },
                  "gain": { "type": "number" },
                  "cut": { "enum": ["none", "hug", "tear", "sub_kill", "air_cap", "air_kill", "custom"] }
                }
              }
            }
          }
        }
      }
    },

    "keyframes": {
      "type": "array",
      "description": "BAKED output, written by the compiler. Absent in a source-only recipe; present after bake. THE runtime authority.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "boost", "packedWords"],
        "properties": {
          "label": { "enum": ["M0_Q0", "M100_Q0", "M0_Q100", "M100_Q100"] },
          "boost": { "type": "number" },
          "packedWords": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
            }
          }
        }
      }
    }
  }
}
